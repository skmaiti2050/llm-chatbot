DATABASE_URL=postgresql://postgres:password@localhost:5432/llm_chatbot

# LLM Provider (leave LLM_API_KEY empty for simulation mode)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Context window: number of recent messages sent to the model
CONTEXT_WINDOW_SIZE=20
